{
  "name": "nest-e2e-kit",
  "description": "E2E testing utilities for NestJS applications",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ntraykov/nest-e2e-kit"
  },
  "bugs": "https://github.com/ntraykov/nest-e2e-kit/issues",
  "homepage": "https://github.com/ntraykov/nest-e2e-kit#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --watch",
    "test": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "nestjs",
    "e2e",
    "testing",
    "database",
    "utilities",
    "nest-e2e-kit"
  ],
  "author": "Nikolay Traykov",
  "license": "ISC",
  "dependencies": {
    "mysql2": "^3.22.5"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@types/node": "^25.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11"
  }
}
